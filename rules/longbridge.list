  - DOMAIN-SUFFIX,longbridge.cn,Proxy
  - DOMAIN-SUFFIX,longbridge.hk,Proxy
  - DOMAIN-SUFFIX,longbridge.sg,Proxy
  - DOMAIN-SUFFIX,longbridge.global,Proxy
